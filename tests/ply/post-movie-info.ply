post-movie-info:
  url: ${apiUrl}/movie-infos
  method: POST
  headers:
    Accept: application/json
    Content-Type: application/json
  body: |-
    {
      "title": "Bad Blonde",
      "year": 1953,
      "genre": "Film Noir",
      "credits": [
        {
          "name": "Reginald Le Borg",
          "role": "director"
        },
        {
          "name": "Barbara Payton",
          "role": "actor"
        },
        {
          "name": "Frederick Valk",
          "role": "actor"
        },
        {
          "name": "John Slater",
          "role": "actor"
        },
        {
          "name": "Sidney James",
          "role": "actor"
        },
        {
          "name": "Tony Wright",
          "role": "actor"
        }
      ]
    }
